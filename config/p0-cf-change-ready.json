    "automount_default_service_account_token": false,
    "cluster_admin_forbidden": true,
    "wildcard_rbac_forbidden": true,
    "secrets_read_forbidden": true,
    "pod_security": {
      "allow_privilege_escalation": false,
      "read_only_root_filesystem": true,
      "drop_all_capabilities": true,
