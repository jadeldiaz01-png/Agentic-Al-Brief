    "public_access_forbidden": true,
    "bucket_lock_required_before_evidence_write": true,
    "minimum_lock_seconds": 7776000,
    "temporary_credentials_required": true,
    "temporary_permission": "object-read-write",
    "temporary_prefixes": ["runtime-evidence/"],
    "temporary_ttl_seconds": 900,
    "parent_access_key_must_be_dedicated_and_bucket_scoped": true,
    "control_plane_token_as_s3_credential_forbidden": true
  },
  "required_change_ready_gates": [
    "manual_workflow_dispatch_verified",
    "exact_source_sha_verified",
    "github_hosted_ephemeral_runner_verified",
    "tailscale_federated_identity_verified",
    "kubernetes_context_verified",
    "namespace_verified",
