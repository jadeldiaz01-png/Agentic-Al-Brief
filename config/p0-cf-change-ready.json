    "secrets_read_absent",
    "cloudflared_image_digest_exact",
    "openbao_csi_driver_present",
    "openbao_csi_provider_present",
    "openbao_secret_provider_class_contract_valid",
    "dedicated_service_account_contract_valid",
    "networkpolicy_contract_valid",
    "cloudflare_7844_tcp_reachable",
    "cloudflare_7844_udp_policy_declared",
    "r2_target_state_known",
    "r2_parent_credential_presence_verified_without_value_disclosure",
    "r2_temporary_credential_mint_plan_valid",
    "r2_bucket_lock_plan_valid",
    "rollback_plan_present",
    "writes_still_disabled"
